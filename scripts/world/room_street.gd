extends RoomBase
## Street level — copy shop, rental desk, convenience store, bar. (GDD §6)
## Distances are real. The shop is four minutes if you do not stop.

func _ready() -> void:
	room_id = "street"
	display_name = "Street — Mullae"
	super._ready()
	RoomBuilder.floor(self, Vector2(40, 10), Color(0.42, 0.42, 0.44))
	RoomBuilder.light(self, Vector3(0, 4.0, 0), false, 1.0)
	RoomBuilder.light(self, Vector3(12, 4.0, 0), true, 0.8)
	var spawn := Node3D.new()
	spawn.position = Vector3(-18, 0, 0)
	add_child(spawn)
	register_socket("spawn", spawn)
	# Copy shop (Clerk Yoon will not print the stamp)
	RoomBuilder.box_prop(self, Vector3(-10, 1.2, -3.5), Vector3(4.0, 2.4, 0.4), Color(0.88, 0.86, 0.80), "COPY SHOP — Yoon")
	var yoon := RoomBuilder.interactable(self, Vector3(-10, 1.0, -2.2), Interactable.Weight.ERRAND, "Hand Yoon the tube (she refuses the stamp)", "yoon_refuse", "")
	yoon.activated.connect(_relay)
	var crop := RoomBuilder.interactable(self, Vector3(-8.6, 1.0, -2.2), Interactable.Weight.MANUAL, "Crop on her copier — mask the prohibition", "yoon_crop", "pour")
	crop.activated.connect(_relay)
	var lightbox := RoomBuilder.interactable(self, Vector3(-11.4, 1.0, -2.2), Interactable.Weight.HEAVY, "Trace on the lightbox (follow the boundary)", "lightbox_trace", "trace")
	lightbox.activated.connect(_relay)
	# Rental desk (G90)
	RoomBuilder.box_prop(self, Vector3(0, 1.1, -3.5), Vector3(4.0, 2.2, 0.4), Color(0.20, 0.20, 0.22), "RENTAL DESK")
	var sedan_socket := Node3D.new()
	sedan_socket.name = "sedan"
	sedan_socket.position = Vector3(2.4, 0, -3.2)
	add_child(sedan_socket)
	register_socket("sedan", sedan_socket)
	var g90 := RoomBuilder.interactable(self, Vector3(0, 1.0, -2.2), Interactable.Weight.HEAVY, "Close three luxury cars on ₩180,000", "g90_board", "digits_g90")
	g90.activated.connect(_relay)
	var sign := RoomBuilder.interactable(self, Vector3(1.6, 1.0, -2.2), Interactable.Weight.MANUAL, "Sign the deposit on your card (₩600,000 hole)", "g90_sign", "digits_sign")
	sign.activated.connect(_relay)
	# Convenience store copier in Mullae (longer walk, worse mask, legal flag if too clean)
	RoomBuilder.box_prop(self, Vector3(10, 1.0, -3.5), Vector3(3.0, 2.0, 0.4), Color(0.75, 0.72, 0.68), "MULLAE COPIER")
	var mullae := RoomBuilder.interactable(self, Vector3(10, 1.0, -2.2), Interactable.Weight.MANUAL, "Mullae copier — worse mask, no Yoon", "mullae_copy", "pour")
	mullae.activated.connect(_relay)
	# Convenience whiskey errand + bar pour
	RoomBuilder.box_prop(self, Vector3(14, 1.0, 2.5), Vector3(2.5, 2.0, 2.0), Color(0.70, 0.55, 0.35), "CONVENIENCE")
	var whiskey := RoomBuilder.interactable(self, Vector3(14, 1.0, 1.2), Interactable.Weight.ERRAND, "Buy whiskey (file as office supplies)", "whiskey_buy", "")
	whiskey.activated.connect(_relay)
	RoomBuilder.box_prop(self, Vector3(-2, 1.0, 3.0), Vector3(3.0, 2.0, 2.0), Color(0.45, 0.25, 0.15), "BAR — beer is priced relief")
	var beer := RoomBuilder.interactable(self, Vector3(-2, 1.0, 1.8), Interactable.Weight.MANUAL, "Pour a beer (stress down, smell sticks)", "beer_pour", "pour_beer")
	beer.activated.connect(_relay)
	# Shuttle curb (Jun's van is a curb and a clock — 18:10, no skill, pure time)
	RoomBuilder.box_prop(self, Vector3(18, 0.5, 0), Vector3(1.5, 1.0, 3.0), Color(0.85, 0.70, 0.20), "SHUTTLE CURB 18:10")
	var curb := Node3D.new()
	curb.position = Vector3(18, 0, 2.5)
	add_child(curb)
	register_socket("curb", curb)
	var shuttle := RoomBuilder.interactable(self, Vector3(18, 1.0, 1.6), Interactable.Weight.ERRAND, "Catch Jun's shuttle (miss the curb, driver leaves)", "shuttle_curb", "")
	shuttle.activated.connect(_relay)
	# Thursday hoesik table (wrong direction from the station).
	var hoesik_door := RoomBuilder.interactable(self, Vector3(8, 1.0, -1.0), Interactable.Weight.ERRAND, "Join the table — wrong direction from the station", "go_restaurant", "")
	hoesik_door.activated.connect(_relay)
	# Station entry / office entry doors (masked loads)
	var to_station := RoomBuilder.interactable(self, Vector3(19.5, 1.0, -1.5), Interactable.Weight.ERRAND, "Down to the station (turnstile)", "go_station", "")
	to_station.activated.connect(_relay)
	var to_office := RoomBuilder.interactable(self, Vector3(-19.5, 1.0, 1.5), Interactable.Weight.ERRAND, "Back to the office (elevator)", "go_office", "")
	to_office.activated.connect(_relay)
	# --- Art pass: night street, bilingual fronts, warm shop glow ---
	RoomBuilder.bilingual(self, Vector3(-10, 2.8, -3.3), "COPY SHOP", "복사 가게", ArtDirection.IVORY)
	RoomBuilder.bilingual(self, Vector3(0, 2.6, -3.3), "RENTAL", "렌터카", ArtDirection.GOLD)
	RoomBuilder.bilingual(self, Vector3(10, 2.4, -3.3), "MULLAE COPIER", "문래 복사", ArtDirection.SUBWAY)
	RoomBuilder.tungsten_lamp(self, Vector3(-10, 2.2, -1.5), 1.2)
	RoomBuilder.tungsten_lamp(self, Vector3(-2, 2.2, 2.2), 0.9)
	ArtDirection.stamp_label(self, Vector3(-10, 1.7, -3.2))
	RoomBuilder.try_swap_blender_model(self, "sedan", "res://assets/models/sedan.glb")

func _relay(inter: Interactable) -> void:
	var game := get_tree().get_first_node_in_group("game")
	if game != null and game.has_method("on_interact"):
		game.call("on_interact", inter)
